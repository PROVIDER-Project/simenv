#!/bin/sh
# Git invokes this helper for get/store/erase. Only serve the build secret to GitHub.
set -eu
[ "${1:-}" = get ] || exit 0
protocol=
host=
while IFS='=' read -r key value; do
    case "$key" in
        protocol) protocol="$value" ;;
        host) host="$value" ;;
    esac
done
if [ "$protocol" = https ] && [ "$host" = github.com ]; then
    printf 'username=x-access-token\npassword=%s\n' "$(cat /run/secrets/github_token)"
fi
